# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Placeholder for Step 2)
# DB_ADAPTER options: 'pg' (Production PostgreSQL) or 'pglite' (Local embedded WASM)
DB_ADAPTER=pglite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_campus
PGDATA_PATH=./data/pglite

# Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
