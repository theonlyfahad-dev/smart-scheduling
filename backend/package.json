{
  "name": "smart-campus-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API service for Smart Campus",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx tests/health.test.ts",
    "test:schema": "tsx tests/schema.test.ts",
    "test:adapter": "tsx tests/adapter.test.ts",
    "test:services": "tsx tests/services.test.ts",
    "test:auth-utils": "tsx tests/auth-utils.test.ts",
    "test:auth-setup": "tsx tests/auth-setup.test.ts",
    "test:auth-service": "tsx tests/auth-service.test.ts",
    "test:auth-middleware": "tsx tests/auth-middleware.test.ts",
    "setup:admin": "tsx src/scripts/setup-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
